# Optional AI Copilot external model provider.
# Leave AI_COPILOT_PROVIDER empty/local to use the built-in deterministic Copilot only.
# Supported providers:
# - openai: OpenAI-compatible /v1/chat/completions endpoint
# - gemini: Google Gemini generateContent endpoint
# - custom: POST query, prompt, localResponse and contextSummary to AI_COPILOT_BASE_URL
AI_COPILOT_PROVIDER=""
AI_COPILOT_API_KEY=""
AI_COPILOT_MODEL="gpt-4o-mini"
AI_COPILOT_BASE_URL=""

# PORT: Optional local dev/preview port. Defaults to 3006.
PORT=3006

# PostgreSQL connection string. Use a PostgreSQL database with pgvector enabled.
DATABASE_URL="postgresql://user:password@host:5432/ai_iot_dashboard"
# Set to true for managed Postgres providers that require TLS.
DATABASE_SSL=false

# In-memory audit log buffer size used only when DATABASE_URL is not configured.
AUDIT_LOG_BUFFER_SIZE=1000

# Backend session security. Use a strong secret in production.
AUTH_SESSION_SECRET="change-me-to-a-long-random-secret"
AUTH_SESSION_TTL_SECONDS=43200
AUTH_REFRESH_TTL_SECONDS=1209600
AUTH_SESSION_COOKIE_NAME="ai_iot_session"
AUTH_REFRESH_COOKIE_NAME="ai_iot_refresh"
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_REQUIRED_CLASSES=3
AUTH_IP_BLACKLIST=""
SECURITY_ALERTS_ENABLED=true
SECURITY_ALERT_COOLDOWN_MS=300000

# Workflow execution queue.
# memory is built in. postgres enables a durable DB-backed queue without extra deps.
# redis/bullmq is reserved for a future external queue adapter.
WORKFLOW_QUEUE_MODE="memory"
WORKFLOW_QUEUE_CONCURRENCY=2
WORKFLOW_QUEUE_MAX_PENDING=1000
WORKFLOW_QUEUE_POLL_MS=100
WORKFLOW_QUEUE_STALE_MS=600000
WORKFLOW_QUEUE_MAX_ATTEMPTS=3
REDIS_URL=""

# Telemetry retention policy for PostgreSQL deployments.
TELEMETRY_RETENTION_ENABLED=true
TELEMETRY_RAW_RETENTION_DAYS=90
TELEMETRY_MINUTE_ROLLUP_RETENTION_DAYS=30
TELEMETRY_HOUR_ROLLUP_RETENTION_DAYS=730
TELEMETRY_RETENTION_INTERVAL_MS=3600000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional default backend MQTT subscriber seed. Additional MQTT channels should be
# managed in Settings -> Data Sources and are saved to PostgreSQL when DATABASE_URL
# is configured, otherwise to runtime-config.json for local demos.
MQTT_ENABLED=false
MQTT_BROKER_URL="mqtt://broker.example.com:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPICS="devices/+/telemetry"
