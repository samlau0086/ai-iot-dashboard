# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional local dev/preview port. Defaults to 3006.
PORT=3006

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional external device data API polling fallback.
# Recommended gateway integration is HTTP Push to POST /api/telemetry on this dashboard.
# Response can be either an array of devices or an object like: { "devices": [...] }.
VITE_DEVICE_API_URL=""
VITE_DEVICE_API_TOKEN=""
VITE_DEVICE_API_POLL_MS=10000

# Optional gateway ingest token. If set, gateways must send this token via x-iot-token
# or Authorization: Bearer <token> when POSTing to /api/telemetry.
IOT_INGEST_TOKEN=""

# Optional backend MQTT subscriber defaults. These can also be configured at runtime
# in Settings -> Data Sources and are saved to runtime-config.json on the server.
MQTT_ENABLED=false
MQTT_BROKER_URL="mqtt://broker.example.com:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPICS="devices/+/telemetry"
