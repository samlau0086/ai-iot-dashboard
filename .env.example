# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional local dev/preview port. Defaults to 3006.
PORT=3006

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real device data API. When set, the frontend polls this endpoint and replaces mock devices.
# Response can be either an array of devices or an object like: { "devices": [...] }.
VITE_DEVICE_API_URL=""
VITE_DEVICE_API_TOKEN=""
VITE_DEVICE_API_POLL_MS=10000

# MQTT/WebSocket bridge endpoint. The browser expects JSON telemetry messages over WebSocket.
# Example message:
# { "device_id": "DEV-001", "device_type": "energy_meter", "tags": ["factory-a"], "metrics": { "power": 4070 }, "status": "online", "timestamp": "2026-06-05T10:00:00Z" }
VITE_MQTT_WS_URL=""
